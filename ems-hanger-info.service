[Unit]
Description=EMS Hanger Startup Information Display
After=ems-hanger.service ems-hanger-frontend.service
Wants=ems-hanger.service ems-hanger-frontend.service

[Service]
Type=oneshot
User=pi
ExecStart=/home/vw/Downloads/EMS-HANGER-main/show_startup_info.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ems-hanger-info

[Install]
WantedBy=multi-user.target
